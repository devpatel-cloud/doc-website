# ==============================================================================
# DocVault V2 — Environment Configuration Example (.env.example)
# ==============================================================================
# Copy this file to .env on your server and update values accordingly:
#   cp .env.example .env
#   chmod 600 .env
# ==============================================================================

# Administrator Password for Web Portal Uploads (Required in Production)
DOCVAULT_ADMIN_PASSWORD=change_this_to_a_strong_password_in_production

# Maximum Allowed Upload File Size in Megabytes (Default: 2048 MB / 2 GB)
DOCVAULT_MAX_FILE_SIZE_MB=2048

# Minimum Free Disk Space Threshold in Gigabytes before rejecting uploads (Default: 2.5)
DOCVAULT_MIN_FREE_DISK_GB=2.5

# Cryptographically Secret Session Signing Key (Change in Production)
DOCVAULT_SESSION_SECRET=generate_a_random_64_character_secret_string
